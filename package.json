{
  "name": "cleverprices",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun test src",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit push --config=drizzle.config.ts",
    "db:migrate:cloud": "TURSO_DATABASE_URL=$TURSO_DATABASE_URL TURSO_AUTH_TOKEN=$TURSO_AUTH_TOKEN drizzle-kit push --config=drizzle.config.ts",
    "worker:local": "DB_LOCAL=1 bun run scripts/automation/keepa-worker.ts de -c --no-sync",
    "worker:run": "bun run scripts/automation/keepa-worker.ts",
    "worker:enrich": "DB_LOCAL=1 bun run scripts/import/enrich-products.ts de",
    "db:lite": "./scripts/database/prepare-lite-db.sh",
    "db:push-prod": "scp data/cleverprices-lite.db root@46.225.72.57:/etc/dokploy/volumes/cleverprices/data/cleverprices-lite.db",
    "db:checkpoint": "sqlite3 data/cleverprices.db 'PRAGMA wal_checkpoint(TRUNCATE);'",
    "db:optimize": "sqlite3 data/cleverprices.db 'PRAGMA optimize;'",
    "db:backup": "bun run scripts/backup-db.ts",
    "docker:build": "docker build -t cleverprices .",
    "import": "bun run scripts/import/import-from-csv.ts",
    "db:deploy": "bun run scripts/database/deploy-data.ts",
    "db:pull": "bun run scripts/database/pull-data.ts",
    "db:indexes": "bun run scripts/database/add-indexes.ts",
    "warm-cache": "bun run scripts/automation/warm-cache.ts",
    "update-prices": "bun run scripts/automation/update-prices.ts",
    "category:validate": "bun run scripts/maintenance/validate-categories.ts",
    "slugs:fix": "bun run scripts/maintenance/regenerate-slugs.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/lib-storage": "^3.981.0",
    "@libsql/client": "^0.17.0",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
