{
  "name": "cleverprices",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun test src",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "worker:local": "DB_LOCAL=1 bun run scripts/automation/keepa-worker.ts de -c",
    "worker:run": "bun run scripts/automation/keepa-worker.ts",
    "worker:enrich": "DB_LOCAL=1 bun run scripts/import/enrich-products.ts de",
    "db:DANGEROUS-overwrite-prod": "bun run scripts/database/deploy-data.ts",
    "db:push-hybrid": "bun run scripts/database/hybrid-sync.ts",
    "db:pull-prod": "bun run scripts/database/pull-data.ts",
    "db:checkpoint": "sqlite3 data/cleverprices.db 'PRAGMA wal_checkpoint(TRUNCATE);'",
    "db:backup": "bun run scripts/automation/backup-r2.ts",
    "db:backup-prod": "bun run scripts/automation/backup-r2.ts > data/backup.log 2>&1",
    "docker:build": "docker build -t cleverprices .",
    "import": "bun run scripts/import/import-from-csv.ts",
    "warm-cache": "bun run scripts/automation/warm-cache.ts",
    "update-prices": "bun run scripts/automation/update-prices.ts",
    "category:audit": "bun run scripts/maintenance/validate-categories.ts",
    "sif:audit": "bun run scripts/maintenance/bulk-source-audit.ts",
    "quality:report": "bun run scripts/maintenance/generate-quality-report.ts",
    "slugs:fix": "bun run scripts/maintenance/regenerate-slugs.ts",
    "identity:rebuild": "bun run scripts/intelligence/rebuild-identity-clusters.ts",
    "seo:generate": "bun run scripts/growth/seo-niche-generator.ts",
    "audit:seo": "bun run scripts/maintenance/seo-audit.ts",
    "audit:react": "npx -y react-doctor@latest . --verbose --diff",
    "perf:analyze": "ANALYZE=true next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/lib-storage": "^3.981.0",
    "@libsql/client": "^0.17.0",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.554.0",
    "next": "^16.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/bundle-analyzer": "^16.1.4",
    "@next/mdx": "^16.1.6",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.5",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "fast-levenshtein": "^3.0.0",
    "papaparse": "^5.5.3",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
